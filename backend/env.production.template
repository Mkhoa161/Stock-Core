# Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values

# Application
NODE_ENV=production
PORT=3000
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# URLs
BASE_URL=https://your-ec2-public-ip:3000
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net

# External APIs
FMP_API_KEY=your-fmp-api-key-here

# Database (RDS)
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-rds-password-here
DB_NAME=stock_insight

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-ec2-public-ip:3000/api/auth/google/callback
