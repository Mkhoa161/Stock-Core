# Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values

# Application
NODE_ENV=production
PORT=3000

# URLs
BASE_URL=https://your-ec2-public-ip:3000
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net

# Database (RDS)
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-rds-password-here
DB_NAME=stock_insight

# Docker image (ECR)
# Format: <account-id>.dkr.ecr.<region>.amazonaws.com/stock-core-backend:<tag>
IMAGE_URI=
