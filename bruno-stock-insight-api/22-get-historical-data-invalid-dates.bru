meta {
  name: Get Historical Data (Invalid Dates)
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/api/companies/AAPL/historical?from=invalid-date&to=2024-01-31
  body: none
}

headers {
  Content-Type: application/json
}

docs {
  name: Get Historical Data (Invalid Dates)
  description: |
    Test getting historical data with invalid date parameters.
    
    This endpoint should return:
    - 400 status code for invalid date format
    - Error message indicating invalid date format
}

tests {
  // Check if response is 400
  test("should return 400 status", function() {
    expect(res.status).to.equal(400);
  });

  // Check if response has error message
  test("should return error message", function() {
    expect(res.body).to.have.property('message');
    expect(res.body.message).to.include('Invalid date format');
  });


}
