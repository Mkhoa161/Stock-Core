meta {
  name: Register Valid User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "testuser@example.com",
    "password": "TestPass123",
    "username": "testuser",
    "firstName": "Test",
    "lastName": "User"
  }
}

docs {
  title: Register Valid User
  description: |
    Test registration with valid user data.
    
    This test:
    - Uses valid email format
    - Uses strong password (8+ chars, uppercase, lowercase, number)
    - Includes all required fields
    
  examples: |
    **Expected Response (201):**
    ```json
    {
      "message": "User registered successfully",
      "user": {
        "id": 1,
        "email": "testuser@example.com",
        "username": "testuser",
        "first_name": "Test",
        "last_name": "User"
      },
      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
    }
    ```
} 